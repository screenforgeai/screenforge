# ── Code Signing (macOS) ──────────────────────────────────────────────────────
# Apple Developer credentials for notarization.
# APPLE_API_KEY_ID=     # App Store Connect API key ID (e.g. ABC123DEF4)
# APPLE_API_ISSUER=     # App Store Connect issuer UUID
# APPLE_API_KEY=        # Path to the .p8 private key file

# ── Sentry (Crash Reporting) ──────────────────────────────────────────────────
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# Leave blank to disable Sentry in dev builds.
# SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXXXXXX

# ── PostHog (Product Analytics) ───────────────────────────────────────────────
# Get your project API key from: https://app.posthog.com → Project Settings
# Leave blank to disable PostHog in dev builds.
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# POSTHOG_HOST=https://us.i.posthog.com   # optional — defaults to US cloud
