{
  "name": "screenforge",
  "productName": "Screenforge",
  "version": "0.8.0",
  "description": "A free, open-source screen recording tool that automatically zooms and tracks your cursor to create polished screen recordings. No watermark, no subscriptions.",
  "main": ".vite/build/main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/screenforgeai/screenforge.git"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac": "node scripts/make-platform.mjs mac",
    "make:win": "node scripts/make-platform.mjs win",
    "make:linux": "node scripts/make-platform.mjs linux",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test:unit": "vitest run",
    "test:export": "vitest run --config vitest.export.config.ts",
    "test:all": "pnpm test:unit && pnpm test:export",
    "bench:export": "node scripts/bench-export.mjs",
    "verify:packaged:export": "node scripts/verify-packaged-export.mjs",
    "test:unit:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\"",
    "changeset": "changeset",
    "version": "changeset version",
    "version-packages": "changeset version && node scripts/sync-platform-versions.mjs",
    "build:icon:macos": "bash scripts/build-macos-app-icon.sh",
    "build:icon:windows": "bash scripts/build-windows-app-icon.sh",
    "build:native:macos": "bash scripts/build-native-macos.sh",
    "build:ffmpeg:macos": "bash scripts/build-ffmpeg-macos.sh",
    "download:ffmpeg:windows": "bash scripts/download-ffmpeg-windows.sh",
    "download:ffmpeg:linux": "bash scripts/download-ffmpeg-linux.sh",
    "build:icon:linux": "bash scripts/build-linux-app-icon.sh",
    "build:native:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-native-windows.ps1",
    "ci:tag-release": "bash scripts/create-release-tag.sh"
  },
  "keywords": [
    "screen-recorder",
    "screen-recording",
    "screencast",
    "auto-zoom",
    "cursor-tracking",
    "video-editor",
    "product-demo",
    "tutorial",
    "captions",
    "whisper",
    "ffmpeg",
    "electron",
    "react",
    "open-source",
    "macos",
    "windows",
    "linux"
  ],
  "author": {
    "name": "Mohib Arshi",
    "email": "mohib@screenforge.co"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@reforged/maker-appimage": "^5.2.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "45.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~4.5.4",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "fs-xattr",
      "macos-alias"
    ],
    "patchedDependencies": {
      "@xzdarcy/react-timeline-editor@1.0.0": "patches/@xzdarcy__react-timeline-editor@1.0.0.patch"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.6",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@xzdarcy/react-timeline-editor": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^12.34.3",
    "i18next": "^26.0.8",
    "lucide-react": "^0.575.0",
    "mediabunny": "^1.40.1",
    "motion": "^12.34.3",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.17.1",
    "posthog-node": "^5.29.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hotkeys-hook": "^5.2.4",
    "react-i18next": "^17.0.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uiohook-napi": "^1.5.4",
    "wavefile": "^11.0.0",
    "zustand": "^5.0.11"
  }
}
